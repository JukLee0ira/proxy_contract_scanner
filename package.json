{
  "name": "proxy_scanner",
  "version": "1.0.0",
  "description": "Proxy contract scanner and monitoring tool with Hardhat support",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:connectivity": "jest test/connectivity.test.ts",
    "test:business": "jest test/business.test.ts",
    "test:business-simple": "jest test/business-simple.test.ts",
    "test:all": "jest test/connectivity.test.ts test/business-simple.test.ts",
    "start": "ts-node src/demo/proxyScannerDemo.ts",
    "scan": "ts-node src/demo/proxyScannerDemo.ts --scan",
    "dev": "nodemon --exec ts-node src/demo/proxyScannerDemo.ts",
    "build": "tsc",
    "compile": "node scripts/compile.js",
    "hardhat:test": "hardhat test",
    "hardhat:compile": "hardhat compile"
  },
  "keywords": [
    "proxy",
    "scanner",
    "ethereum",
    "hardhat",
    "blockchain"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ethersproject/abi": "^5.8.0",
    "@ethersproject/contracts": "^5.8.0",
    "@ethersproject/providers": "^5.8.0",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "axios": "^1.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "ethers": "^6.15.0",
    "express": "^4.19.2",
    "nodemon": "^3.1.10",
    "pg": "^8.16.3",
    "solc": "^0.8.28",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^2.0.2",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@types/chai": "^5.2.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "chai": "^6.2.0",
    "hardhat": "^2.14.0",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.4"
  }
}
